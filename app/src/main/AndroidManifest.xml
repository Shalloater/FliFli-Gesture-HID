<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 11 及以下的传统蓝牙权限 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- Android 12+：连接已配对蓝牙设备、让本机可被发现 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_blue"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <service
            android:name=".HidRemoteService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
        </activity>
        <activity-alias android:name=".LauncherBlue" android:targetActivity=".MainActivity"
            android:enabled="true" android:exported="true"
            android:icon="@drawable/ic_launcher_blue" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherPink" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@drawable/ic_launcher_pink" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherPurple" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@drawable/ic_launcher_purple" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherGreen" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@drawable/ic_launcher_green" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherBlack" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@drawable/ic_launcher_black" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
